# Public configuration of the web app (everything here ends up in the browser bundle: no secrets).

# Where the browser sends API requests. `/api` goes through the dev server proxy below, so the
# backend needs no CORS in development. In production it is the API origin or a path the
# deployment proxies (decided with the deployment, not in map-governments).
VITE_API_BASE_URL=/api

# Dev server only: where the `/api` proxy forwards to (the backend of `../back`).
API_PROXY_TARGET=http://localhost:8000
