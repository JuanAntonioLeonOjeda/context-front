    "/communities/{territory_id}/news": {
      "get": {
        "tags": [
          "news"
        ],
        "summary": "Community",
        "description": "The news of a range of days (Spain time) that the active classifier placed in this community and\nsector. Without dates: the last 7 days, today included. With `date_from` and/or\n`date_to` (ISO dates, both included): that range, of at most 31 days. At most\n5 per outlet and day (its newest).\n\nNothing is deleted: any day the collector ran can be asked for. A day it did not run, or before the\nportal began collecting, answers an empty list, not an error.\n\n**Order:** publication time, newest first; ties by outlet id. The order never depends on an\noutlet's size, audience or line.\n\nNo item names a party (ADR-0018): who governs the community is in\n`/communities/{territory_id}/governments`.",
        "operationId": "community_communities__territory_id__news_get",
        "parameters": [
          {
            "name": "territory_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Territory Id"
            }
          },
          {
            "name": "sector",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "A sector id: education, health or housing",
              "title": "Sector"
            },
            "description": "A sector id: education, health or housing"
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "First day, ISO date",
              "title": "Date From"
            },
            "description": "First day, ISO date"
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last day, ISO date",
              "title": "Date To"
            },
            "description": "Last day, ISO date"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunityNewsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/communities/{territory_id}/trees": {
      "get": {
        "tags": [
          "news"
        ],
        "summary": "Trees",
        "description": "The trees of related stories that reach this community and sector, one item per tree: the newest\nnews of the tree that the active classifier placed there. No dates filter them. `tree_story_id` of\neach item is the story to ask `/stories/{story_id}/tree` for, which answers the whole tree.\n\n**Order:** publication time of that news, newest first; ties by outlet id. The order never depends\non an outlet's size, audience or line. No item names a party (ADR-0018).",
        "operationId": "trees_communities__territory_id__trees_get",
        "parameters": [
          {
            "name": "territory_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Territory Id"
            }
          },
          {
            "name": "sector",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "A sector id: education, health or housing",
              "title": "Sector"
            },
            "description": "A sector id: education, health or housing"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunityTreesOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/communities/{territory_id}/stories": {
      "get": {
        "tags": [
          "stories"
        ],
        "summary": "Community",
        "description": "The stories of the last 30 days (today included, Spain time): groups of articles from\ndifferent outlets about the same event. A story belongs to this community (and sector, when\ngiven) when more than half of its articles are classified there by the active classifier. At most\n50 stories.\n\n**Order:** stories by their newest article, newest first, ties by story id; inside a story, articles\nby outlet id, then publication time. The order never depends on an outlet's size, audience or line.\n\n`grouping` says how the stories were made: the threshold is provisional until pairs are labelled\nby hand. It is `null` until the first grouping run exists.",
        "operationId": "community_communities__territory_id__stories_get",
        "parameters": [
          {
            "name": "territory_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Territory Id"
            }
          },
          {
            "name": "sector",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A sector id: education, health or housing",
              "title": "Sector"
            },
            "description": "A sector id: education, health or housing"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunityStoriesOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/stories/{story_id}/tree": {
      "get": {
        "tags": [
          "stories"
        ],
        "summary": "Tree",
        "description": "The tree of related stories the story belongs to, from the latest linking run: each story points\nat the earlier story it continues (`parent_story_id`, null for the root). A link only says\n\"related and later\": it does not say why.\n\n**Order:** nodes by the publication time of their first article, oldest first, ties by story id;\ninside a node, articles by outlet id, then publication time. The order never depends on an\noutlet's size, audience or line.\n\n`linking` says how the links were made and `grouping` how the stories were; both thresholds are\nprovisional until pairs are labelled by hand. 404 when the story has no relations.",
        "operationId": "tree_stories__story_id__tree_get",
        "parameters": [
          {
            "name": "story_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Story Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoryTreeOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/communities/{territory_id}/voters": {
      "get": {
        "tags": [
          "voters"
        ],
        "summary": "Community",
        "description": "How the municipalities of a community voted in a general election, grouped in\nfive income bands of about the same census (each municipality whole, in the band where the\nmidpoint of its census falls; a big city can leave a band almost empty). Income: the INE's mean net\nincome per person of the election's year. It describes areas, not people.\n\nWithout `election`, the latest loaded one. Groups: the parties with at least\n`shown_from_percent` % of the community's valid votes (and a candidature that is not in the party\ntable, by its acronym), then \"others\". `profile` is null when fewer than two municipalities have\nincome (Ceuta, Melilla). 404: the community does not exist, or no such election is loaded.",
        "operationId": "community_communities__territory_id__voters_get",
        "parameters": [
          {
            "name": "territory_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Territory Id"
            }
          },
          {
            "name": "election",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "e.g. congreso-2023-07",
              "title": "Election"
            },
            "description": "e.g. congreso-2023-07"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VotersOut"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
