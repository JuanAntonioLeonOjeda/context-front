    "/communities/{territory_id}/news": {
      "get": {
        "tags": [
          "news"
        ],
        "summary": "Community",
        "description": "The news of the last 30 days (today included, Spain time) that the active classifier\nplaced in this community and sector, at most 5 per outlet (its newest).\n\n**Order:** publication time, newest first; ties by outlet id. The order never depends on an\noutlet's size, audience or line.\n\nEach item carries its attribution, computed on read from the competence table and the\ngovernment in force on the publication date in Spain (ADR-0014): one entry per government\nlevel the article names, or a single `not_determined` entry with its reason.",
        "operationId": "community_communities__territory_id__news_get",
        "parameters": [
          {
            "name": "territory_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Territory Id"
            }
          },
          {
            "name": "sector",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "A sector id: education, health or housing",
              "title": "Sector"
            },
            "description": "A sector id: education, health or housing"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunityNewsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
